%{ for group_name, instances in groups ~}
[${group_name}]
%{ if can(instances.id) ~}
${instances["name"]} ansible_host=${instances["network_interface"][0]["nat_ip_address"] != "" ? instances["network_interface"][0]["nat_ip_address"] : instances["network_interface"][0]["ip_address"]} fqdn=${instances["fqdn"]}
%{ else ~}
%{ for i in instances ~}
${i["name"]} ansible_host=${i["network_interface"][0]["nat_ip_address"] != "" ? i["network_interface"][0]["nat_ip_address"] : i["network_interface"][0]["ip_address"]} fqdn=${i["fqdn"]}
%{ endfor ~}
%{ endif ~}

%{ endfor ~}
